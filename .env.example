# ---------------------------------------------------------------------------
# Copie este archivo como ".env" y ajuste los valores segun su equipo.
#   Windows (CMD):        copy .env.example .env
#   Windows (PowerShell): Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# Motor de base de datos: "sqlite" (no requiere instalacion) o "mysql"
DB_DRIVER=sqlite

# --- Solo cuando DB_DRIVER=mysql ---
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=sistema_showroom
DB_USUARIO=root
DB_CLAVE=

# Clave para firmar los tokens JWT.
# IMPORTANTE: en produccion debe ser una cadena larga y aleatoria.
JWT_SECRETO=cambie-esta-clave-secreta-por-una-larga-y-aleatoria
JWT_MINUTOS_VIGENCIA=120

# Entorno: "desarrollo" muestra detalles de error, "produccion" no.
APP_ENTORNO=desarrollo

# --- Reglas de negocio ---
NEGOCIO_IVA=19
NEGOCIO_DIAS_COTIZACION=15
NEGOCIO_DESCUENTO_MAXIMO=20
NEGOCIO_POR_PAGINA=20
